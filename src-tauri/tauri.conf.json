{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loop Lab",
  "version": "1.0.0",
  "identifier": "co.dunwell.looplab",
  "build": {
    "frontendDist": "https://looplab.dunwell.co"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Loop Lab",
        "url": "https://looplab.dunwell.co",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "copyright": "",
    "shortDescription": "Audition sample loops locked to your drums",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
